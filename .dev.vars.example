# Google service account credentials. Keep the real .dev.vars out of Git.
GOOGLE_CLIENT_EMAIL=service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=your_google_sheet_id
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your_google_sheet_id/edit

# FreeModel AI Integration (for schedule scanning with OCR)
FREEMODEL_API_KEY=replace-with-freemodel-api-key
FREEMODEL_MODEL=replace-with-model-name
FREEMODEL_BASE_URL=https://api.your-freemodel-provider.com/v1/messages

# Optional
APP_TIMEZONE=Europe/Berlin
REQUIRE_ACCESS=false

