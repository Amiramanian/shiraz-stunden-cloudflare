{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shiraz-stunden",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "secrets": {
    "required": [
      "APP_PIN",
      "GOOGLE_CLIENT_EMAIL",
      "GOOGLE_PRIVATE_KEY",
      "GEMINI_API_KEY",
      "GROQ_API_KEY"
    ]
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "2026072801",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shiraz-stunden-db",
      "database_id": "4d83d2e4-f227-4e77-b081-20600267ac00",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["15 2 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "APP_TIMEZONE": "Europe/Berlin",
    "GOOGLE_SPREADSHEET_ID": "1XmfVLnebQ7NdLV2qh2nJ_qgPQPIQdqkgw178ZfCyyuY",
    "GOOGLE_SHEET_URL": "https://docs.google.com/spreadsheets/d/1XmfVLnebQ7NdLV2qh2nJ_qgPQPIQdqkgw178ZfCyyuY/preview",
    "GEMINI_BASE_URL": "https://generativelanguage.googleapis.com/v1beta",
    "GEMINI_MODEL": "gemini-flash-latest",
    "GROQ_BASE_URL": "https://api.groq.com/openai/v1",
    "GROQ_SPEECH_MODEL": "whisper-large-v3-turbo"
  }
}
