{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shiraz-stunden",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shiraz-stunden-db",
      "database_id": "4d83d2e4-f227-4e77-b081-20600267ac00",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["15 2 * * *"]
  },
  "vars": {
    "APP_TIMEZONE": "Europe/Berlin",
    "GOOGLE_SPREADSHEET_ID": "1XmfVLnebQ7NdLV2qh2nJ_qgPQPIQdqkgw178ZfCyyuY",
    "GOOGLE_SHEET_URL": "https://docs.google.com/spreadsheets/d/1XmfVLnebQ7NdLV2qh2nJ_qgPQPIQdqkgw178ZfCyyuY/edit"
  }
}
